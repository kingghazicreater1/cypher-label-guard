# ==============================================================================
# CypherLabelGuard CORE EDITION v2.0 - Environment Configuration Template
# COPY this file to .env and insert your real credentials.
# NEVER commit the real .env to version control!
# ==============================================================================

# Database Connection (Defaults to local SQLite)
DATABASE_URL=sqlite:///./cypher_label_guard.db

# Authentication & Security
JWT_SECRET=super_secret_jwt_signing_key_replace_me_in_production

# LLM API Providers (BYOK - Bring Your Own Keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Email / 2FA Gatekeeper (Free Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_NAME=CypherLabelGuard
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Optional Integrations
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
TWILIO_ACCOUNT_SID=
